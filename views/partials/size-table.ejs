<%
  // Tabla de medidas: se usa en /sizes y en el modal de la ficha de producto.
  const sizes = [
    { letter: "XS", us: "0–2", waist: "62–66 cm", hip: "87–91 cm", cup: "Copa A" },
    { letter: "S", us: "4–6", waist: "67–71 cm", hip: "92–97 cm", cup: "Copa B" },
    { letter: "M", us: "8–10", waist: "72–76 cm", hip: "98–102 cm", cup: "Copa C" },
    { letter: "L", us: "12–14", waist: "77–84 cm", hip: "103–109 cm", cup: "Copa C/D" },
  ];
%>
<!-- Tabla (en móvil cada fila se vuelve una tarjeta) -->
<div class="sizes__table-wrap">
    <table class="sizes-table">
        <thead>
            <tr>
                <th scope="col">Talla <small>(letra)</small></th>
                <th scope="col">Talla numérica <small>(US)</small></th>
                <th scope="col">Cintura</th>
                <th scope="col">Cadera</th>
                <th scope="col">Busto <small>(copa)</small></th>
            </tr>
        </thead>
        <tbody>
            <% sizes.forEach((s) => { %>
                <tr>
                    <th scope="row" data-label="Talla"><span class="sizes-table__badge"><%= s.letter %></span></th>
                    <td data-label="Talla numérica (US)"><%= s.us %></td>
                    <td data-label="Cintura"><%= s.waist %></td>
                    <td data-label="Cadera"><%= s.hip %></td>
                    <td data-label="Busto (copa)"><%= s.cup %></td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>
