<%
  // El footer se pinta dos veces para el efecto "reveal" en escritorio:
  //  - "fixed": queda fijo detrás de la página (solo escritorio).
  //  - "placeholder": ocupa su lugar al final del contenido; en móvil es el footer visible.
  const isFixed = variant === "fixed";
  const wa = store.whatsapp;
  const waUrl = `https://wa.me/${wa.number}?text=${encodeURIComponent(wa.message)}`;
  const id = (name) => `${name}-${variant}`; // ids únicos aunque el footer aparezca dos veces

  const columns = [
    {
      key: "shop",
      title: "Tienda",
      links: [
        { href: "/#bikinis", label: "Bikinis" },
        { href: "/#jumpsuits", label: "Enterizos" },
        { href: "/#crochets", label: "Bikinis tejidos" },
        { href: "/#sets", label: "Sets de playa" },
      ],
    },
    {
      key: "help",
      title: "Ayuda",
      links: [
        { href: "/sizes", label: "Guía de tallas" },
        { href: "/policy#envios", label: "Envíos" },
        { href: "/policy#cambios", label: "Cambios" },
        { href: "/policy", label: "Condiciones de venta" },
      ],
    },
  ];
%>
<footer class="footer <%= isFixed ? 'footer--fixed' : 'footer--placeholder' %>">
    <div class="footer__inner">
        <div class="footer__body">

            <!-- Marca + contacto directo -->
            <div class="footer__intro">
                <p class="footer__tagline">Tejido a mano en Costa Rica.</p>
                <a class="footer__cta" href="<%= waUrl %>" target="_blank" rel="noopener">
                    <svg class="footer__cta-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                        <path fill="currentColor"
                            d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.87 9.87 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91A9.85 9.85 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.18-1.14l-.3-.18-3.12.82.83-3.04-.2-.31a8.23 8.23 0 0 1-1.26-4.39c0-4.54 3.7-8.24 8.25-8.24a8.24 8.24 0 0 1 8.24 8.25c0 4.54-3.7 8.23-8.25 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.16.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.42h-.48c-.17 0-.43.06-.66.31-.23.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.08.15-1.18-.06-.11-.22-.17-.47-.29Z" />
                    </svg>
                    Escríbenos por WhatsApp
                </a>
            </div>

            <!-- Columnas -->
            <div class="footer__grid">
                <% columns.forEach((col) => { %>
                    <nav class="footer__col" aria-labelledby="<%= id(col.key) %>">
                        <h2 class="footer__heading" id="<%= id(col.key) %>"><%= col.title %></h2>
                        <ul class="footer__list">
                            <% col.links.forEach((link) => { %>
                                <li><a class="footer__link" href="<%= link.href %>"><%= link.label %></a></li>
                            <% }) %>
                        </ul>
                    </nav>
                <% }) %>

                <section class="footer__col footer__col--contact" aria-labelledby="<%= id('contact') %>">
                    <h2 class="footer__heading" id="<%= id('contact') %>">Contacto</h2>
                    <address class="footer__list footer__address">
                        <span><%- store.location.replace(/, (?=[^,]+$)/, ",<br>") %></span>
                        <a class="footer__link" href="<%= waUrl %>" target="_blank" rel="noopener">
                            WhatsApp <span class="footer__nowrap"><%= wa.display %></span>
                        </a>
                        <span class="footer__shipping">
                            Envíos por
                            <%- img("/images/correos.png", { class: "footer__carrier-logo", alt: "Correos de Costa Rica", sizes: "100px" }) %>
                        </span>
                    </address>
                </section>

                <section class="footer__col" aria-labelledby="<%= id('social') %>">
                    <h2 class="footer__heading" id="<%= id('social') %>">Síguenos</h2>
                    <div class="footer__social">
                        <a class="footer__social-link" href="<%= store.social.instagram %>" target="_blank" rel="noopener"
                            aria-label="Instagram de 100 Puntadas">
                            <img src="/images/insta.svg" alt="" width="28" height="28" loading="lazy" />
                        </a>
                        <a class="footer__social-link" href="<%= store.social.pinterest %>" target="_blank" rel="noopener"
                            aria-label="Pinterest de 100 Puntadas">
                            <img src="/images/pinterest.svg" alt="" width="28" height="28" loading="lazy" />
                        </a>
                    </div>
                </section>
            </div>

            <!-- Barra inferior -->
            <div class="footer__bottom">
                <p class="footer__copy">© <%= new Date().getFullYear() %> 100PUNTADAS</p>

                <div class="footer__payments">
                    <span class="footer__payments-label">Pagos seguros</span>
                    <ul class="footer__payment-list" aria-label="Medios de pago aceptados">
                        <li class="footer__payment footer__payment--text">SINPE</li>
                        <li class="footer__payment"><img src="/images/visa.svg" alt="Visa" width="42" height="26" loading="lazy"></li>
                        <li class="footer__payment"><img src="/images/mastercard.svg" alt="Mastercard" width="42" height="26" loading="lazy"></li>
                        <li class="footer__payment"><img src="/images/amex.svg" alt="American Express" width="42" height="26" loading="lazy"></li>
                        <li class="footer__payment"><img src="/images/maestro.svg" alt="Maestro" width="42" height="26" loading="lazy"></li>
                    </ul>
                </div>
            </div>

            <div class="footer__logo-wrap">
                <%- img("/images/footer-logo.webp", { class: "footer__logo", alt: "100 Puntadas", sizes: "100vw" }) %>
            </div>
        </div>
    </div>
</footer>
