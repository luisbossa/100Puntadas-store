<%
  // En la home los enlaces van a las anclas directamente; en otras páginas, a la home + ancla.
  const anchor = (id) => (isHome ? "#" : "/#") + id;
  // Colecciones del menú: vienen de la base de datos (middleware en app.js).
  const collections = (locals.navCollections || []).map(({ id, title }) => ({ id, label: title }));
  const wa = store.whatsapp;
  const waUrl = `https://wa.me/${wa.number}?text=${encodeURIComponent(wa.message)}`;
%>
<header class="header <%= noCursorZone ? 'no-cursor-zone' : '' %>" id="siteHeader">

    <div class="header__inner">
        <!-- Barra de promoción (el contenido se repite para el desplazamiento infinito) -->
        <div class="promo-marquee" role="region" aria-label="Promoción">
            <div class="promo-marquee__track">
                <% for (let i = 0; i < 4; i++) { %>
                    <% if (locals.campaign) { %>
                        <span class="promo-marquee__highlight" <%- i ? 'aria-hidden="true"' : '' %>><%= campaign.name.toUpperCase() %></span>
                        <span <%- i ? 'aria-hidden="true"' : '' %>><%= (campaign.banner_text || `${campaign.percent}% de descuento en toda la tienda`).toUpperCase() %> · <span class="promo-marquee__accent">-<%= campaign.percent %>%</span></span>
                    <% } else { %>
                        <span class="promo-marquee__highlight" <%- i ? 'aria-hidden="true"' : '' %>>PROMOCIÓN DE VERANO</span>
                        <span <%- i ? 'aria-hidden="true"' : '' %>>LLEVA DOS PRENDAS Y AHORRA UN <span class="promo-marquee__accent">15%</span></span>
                    <% } %>
                    <span <%- i ? 'aria-hidden="true"' : '' %>>DESCUENTO AUTOMÁTICO</span>
                <% } %>
            </div>
        </div>

        <div class="header__bar">
            <nav class="header__nav" aria-label="Colecciones">
                <% collections.forEach((c) => { %>
                    <a href="<%= anchor(c.id) %>" class="nav-link" data-section="<%= c.id %>"><%= c.label %></a>
                <% }) %>
            </nav>

            <div class="header__logo">
                <a href="/" class="header__logo-link" <%- isHome ? 'aria-current="page"' : '' %>>
                    <%- img("/images/logo.png", { alt: "100 Puntadas — inicio", class: "header__logo-img", sizes: "160px", loading: "eager" }) %>
                </a>
            </div>

            <button type="button" class="hamburger" id="hamburger" aria-label="Abrir menú"
                aria-expanded="false" aria-controls="mobileMenu">
                <span></span>
                <span></span>
                <span></span>
            </button>

            <div class="header__actions">
                <a href="<%= anchor('testimonials') %>" class="nav-link" data-section="testimonials">Testimonios</a>
                <a href="/sizes" class="nav-link">Tallas</a>
                <button type="button" id="openCartBtn" class="cart-button" aria-controls="cartPanel"
                    aria-haspopup="dialog" aria-label="Abrir carrito">
                    <span class="cart-text" aria-hidden="true">Carrito</span>

                    <span class="cart-button__icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor"
                            viewBox="0 0 16 16" class="cart-icon" aria-hidden="true">
                            <path
                                d="M0 1a1 1 0 0 1 1-1h1.5a1 1 0 0 1 .96.73L3.89 3H14a1 1 0 0 1 .98 1.2l-1.5 6A1 1 0 0 1 12.5 11H4a1 1 0 0 1-.96-.73L1.61 2H1a1 1 0 0 1-1-1z" />
                            <circle cx="6" cy="13.5" r="1" />
                            <circle cx="11" cy="13.5" r="1" />
                        </svg>
                        <span class="cart-count" data-count="0" aria-hidden="true">0</span>
                    </span>
                </button>
            </div>
        </div>
    </div>

</header>

<!-- MENÚ MÓVIL -->
<div class="mobile-menu <%= noCursorZone ? 'no-cursor-zone' : '' %>" id="mobileMenu" role="dialog" aria-modal="true"
    aria-label="Menú">

    <div class="mobile-menu__top">
        <a href="/" class="mobile-menu__logo">
            <%- img("/images/logo.png", { alt: "100 Puntadas — inicio", sizes: "120px" }) %>
        </a>
        <button type="button" class="mobile-menu__close" id="closeMenuBtn" aria-label="Cerrar menú">
            <span></span>
            <span></span>
        </button>
    </div>

    <nav class="mobile-menu__nav" aria-label="Menú principal">
        <p class="mobile-menu__heading">Colecciones</p>
        <ul class="mobile-menu__list">
            <% collections.forEach((c, i) => { %>
                <li style="--i: <%= i %>">
                    <a href="<%= anchor(c.id) %>" class="mobile-menu__link">
                        <%= c.label %>
                        <span class="mobile-menu__arrow" aria-hidden="true">→</span>
                    </a>
                </li>
            <% }) %>
        </ul>

        <ul class="mobile-menu__secondary">
            <li style="--i: 4"><a href="<%= anchor('testimonials') %>" class="mobile-menu__sublink">Testimonios</a></li>
            <li style="--i: 5"><a href="/sizes" class="mobile-menu__sublink">Guía de tallas</a></li>
            <li style="--i: 6"><a href="/policy" class="mobile-menu__sublink">Condiciones de venta</a></li>
        </ul>
    </nav>

    <div class="mobile-menu__footer">
        <a class="mobile-menu__cta" href="<%= waUrl %>" target="_blank" rel="noopener">Escríbenos por WhatsApp</a>
        <div class="mobile-menu__social">
            <a href="<%= store.social.instagram %>" target="_blank" rel="noopener" aria-label="Instagram de 100 Puntadas">
                <img src="/images/insta.svg" alt="" width="32" height="32" loading="lazy">
            </a>
            <a href="<%= store.social.pinterest %>" target="_blank" rel="noopener" aria-label="Pinterest de 100 Puntadas">
                <img src="/images/pinterest.svg" alt="" width="32" height="32" loading="lazy">
            </a>
        </div>
    </div>
</div>
