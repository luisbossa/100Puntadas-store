<main class="onvo-wrapper">
    <h1 class="onvo-heading">Realiza tu pago</h1>

    <!-- El SDK de ONVO dibuja aquí el formulario de la tarjeta -->
    <div id="onvo-checkout-container" class="onvo-checkout" data-public-key="<%= ONVO_PUBLIC_KEY %>"
        data-payment-intent="<%= String(paymentIntentId).split(':')[0] %>">
        <p class="onvo-loading">Cargando el formulario de pago seguro…</p>
    </div>
</main>

<link rel="stylesheet" href="<%= asset('/css/onvo-pay.css') %>" />

<script src="https://sdk.onvopay.com/sdk.js" defer></script>
<script src="<%= asset('/js/onvo-pay.js') %>" defer></script>
