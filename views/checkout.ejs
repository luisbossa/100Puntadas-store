<%
  // Campo de texto con etiqueta, asterisco de obligatorio y espacio para el error.
  const field = ({ name, label, placeholder, type = "text", required = true, attrs = "" }) => `
    <div class="field">
      <label class="field__label" for="${name}">${label}${required ? '<span class="field__required" aria-hidden="true">*</span>' : ""}</label>
      <input class="input" name="${name}" id="${name}" type="${type}" placeholder="${placeholder}"
        ${required ? "required" : ""} ${attrs} aria-describedby="${name}-error" />
      <small class="field__error" id="${name}-error" aria-live="polite"></small>
    </div>`;

  const select = (name, label, placeholder, locked) => `
    <div class="field">
      <label class="field__label" for="${name}">${label}<span class="field__required" aria-hidden="true">*</span></label>
      <select class="input" name="${name}" id="${name}" required ${locked ? 'data-locked="true"' : ""} aria-describedby="${name}-error">
        <option value="">${placeholder}</option>
      </select>
      <small class="field__error" id="${name}-error" aria-live="polite"></small>
    </div>`;
%>
<main>
    <form id="checkoutForm" class="checkout-grid" novalidate>

        <div class="checkout-grid__main">
            <!-- CONTACTO -->
            <section class="card" aria-labelledby="contact-title">
                <h2 id="contact-title" class="card__title"><span class="card__num" aria-hidden="true">1</span>Información de contacto</h2>

                <div class="field-row">
                    <%- field({ name: "email", label: "Correo electrónico", placeholder: "Correo electrónico", type: "email", attrs: 'autocomplete="email"' }) %>
                    <%- field({ name: "phone", label: "Número de teléfono", placeholder: "Teléfono de contacto", type: "tel", attrs: 'inputmode="numeric" autocomplete="tel-national"' }) %>
                </div>
            </section>

            <!-- ENTREGA -->
            <section class="card" aria-labelledby="shipping-title">
                <h2 id="shipping-title" class="card__title"><span class="card__num" aria-hidden="true">2</span>Dirección de entrega</h2>

                <div class="field-row">
                    <%- field({ name: "full_name", label: "Nombre completo", placeholder: "Nombre completo", attrs: 'autocomplete="name"' }) %>
                    <%- field({ name: "national_id", label: "Cédula de identificación", placeholder: "Cédula de identificación", attrs: 'inputmode="numeric" maxlength="11"' }) %>
                </div>

                <div class="field-row">
                    <%- select("province", "Provincia", "Provincia", false) %>
                    <%- select("canton", "Cantón", "Cantón", true) %>
                </div>

                <div class="field-row">
                    <%- select("district", "Distrito", "Distrito", true) %>
                    <%- field({ name: "neighborhood", label: "Barrio", placeholder: "Barrio o comunidad" }) %>
                </div>

                <%- field({ name: "address", label: "Dirección", placeholder: "Dirección", attrs: 'autocomplete="street-address"' }) %>

                <div class="field">
                    <label class="field__label" for="address_details">Indicaciones adicionales</label>
                    <textarea class="input input--textarea" name="address_details" id="address_details"
                        placeholder="Información adicional del domicilio"></textarea>
                </div>
            </section>
        </div>

        <aside class="checkout-grid__aside">
            <!-- TIPO DE ENVÍO -->
            <section class="card" aria-labelledby="delivery-title">
                <h2 id="delivery-title" class="card__title"><span class="card__num" aria-hidden="true">3</span>Tipo de envío</h2>

                <div class="radio-field" role="radiogroup" aria-labelledby="delivery-title">
                    <label class="radio-option">
                        <input type="radio" name="shipping_type" value="correos" checked>
                        <span>
                            Correos de Costa Rica:
                            <small><b><%= formatPrice(2500) %></b></small>
                        </span>
                    </label>

                    <label class="radio-option">
                        <input type="radio" name="shipping_type" value="store">
                        <span>
                            Recoger en físico
                            <small>L–V 11am–7pm · Sáb 11am–6pm</small>
                        </span>
                    </label>
                </div>
            </section>

            <!-- RESUMEN -->
            <section class="summary-card" aria-labelledby="summary-title">
                <h3 id="summary-title" class="card__title card__title--summary">Resumen del pedido</h3>

                <div class="order-products" id="orderProducts"></div>

                <div class="totals-row totals-row--discount" id="discountRow" hidden>
                    <span>Descuento (15%)</span>
                    <span class="totals-row__discount">− <span id="cartDiscount">0 ₡</span></span>
                </div>

                <div class="totals-row totals-row--shipping" id="shippingRow">
                    <span>Envío</span>
                    <span id="shippingCost">0 ₡</span>
                </div>

                <div class="totals-row totals-row--total">
                    <span>Total</span>
                    <span id="orderTotal" aria-live="polite">0 ₡</span>
                </div>

                <div class="payment-methods">
                    <h2 id="payment-title" class="card__title"><span class="card__num" aria-hidden="true">4</span>Método de pago</h2>

                    <div class="radio-field">
                        <div class="radio-group" role="radiogroup" aria-labelledby="payment-title">
                            <label class="radio-option">
                                <input type="radio" name="payment_method" value="sinpe" required>
                                <span>SINPE o Transferencia Bancaria</span>
                            </label>

                            <label class="radio-option">
                                <input type="radio" name="payment_method" value="card">
                                <span>Tarjeta de crédito o débito</span>
                            </label>
                        </div>
                        <small class="form-message" id="formMessage" role="alert"></small>
                    </div>
                </div>

                <button type="submit" id="checkoutBtn" class="checkout-cta">Continuar al pago</button>
            </section>

            <!-- CONFIANZA -->
            <ul class="trust-list">
                <li class="trust-item">
                    <%- img("/images/turst-1.webp", { alt: "", sizes: "38px" }) %>
                    <span>Pago 100% seguro</span>
                </li>
                <li class="trust-item">
                    <%- img("/images/turst-2.webp", { alt: "", sizes: "38px" }) %>
                    <span>Entrega confiable</span>
                </li>
                <li class="trust-item">
                    <%- img("/images/turst-3.webp", { alt: "", sizes: "38px" }) %>
                    <span>Soporte 24/7</span>
                </li>
            </ul>
        </aside>
    </form>
</main>

<link rel="stylesheet" href="<%= asset('/css/checkout.css') %>" />

<script src="<%= asset('/js/constants.js') %>"></script>
<script src="<%= asset('/js/pricing.js') %>"></script>
<script src="<%= asset('/js/checkout.js') %>"></script>
