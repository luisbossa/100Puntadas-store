            <h1 class="visually-hidden">100 Puntadas — vestidos de baño tejidos a mano en Costa Rica</h1>

            <div class="page-section">
                <div class="catalog">
                    <% collections.forEach((collection, sectionIndex) => { %>
                        <section id="<%= collection.id %>" class="catalog__section" aria-labelledby="<%= collection.id %>-title">
                            <h2 id="<%= collection.id %>-title" class="section-title"><%= collection.title %></h2>
                            <ul class="product-grid" role="list">
                                <% collection.products.forEach((product, i) => { %>
                                    <%- include("partials/product-card", { product, eager: sectionIndex === 0 && i < 5 }) %>
                                <% }) %>
                            </ul>
                        </section>
                    <% }) %>
                </div>

                    <!-- TESTIMONIOS -->
                    <%
                      const bubbles = [
                        { mod: "is-1", img: "avatar-1.jpeg", tip: "🌺 Diseño único", w: 64 },
                        { mod: "is-2", img: "avatar-2.jpeg", tip: "👙 Me encanta", w: 64 },
                        { mod: "is-3", img: "avatar-4.jpeg", tip: "☀️ Súper cómodo", w: 64.5 },
                      ];
                      const smallBubbles = [
                        { mod: "is-5", img: "avatar-5.jpeg", w: 34 },
                        { mod: "is-6", img: "avatar-6.jpeg", w: 32 },
                      ];
                    %>
                    <section id="testimonials" class="testimonials-section no-cursor-zone" aria-labelledby="testimonials-title">
                        <div class="testimonials-container">
                            <div class="testimonials-div">
                                <div class="circle-wrap">
                                    <div class="header-wrap">
                                        <h2 id="testimonials-title" class="testimonials-heading">Testimonios que nos inspiran</h2>
                                        <p class="testimonials-text">
                                            Historias reales de clientes que eligieron 100puntadas
                                            y se enamoraron de la calidad, el diseño y el trabajo artesanal.
                                        </p>
                                    </div>

                                    <!-- Avatares decorativos en órbita -->
                                    <div class="circle-small" aria-hidden="true">
                                        <% bubbles.forEach((b) => { %>
                                            <div class="profile-wrap <%= b.mod %>">
                                                <div class="tooltip-wrap">
                                                    <p class="tooltip-text"><%= b.tip %></p>
                                                    <div class="arrow-wrap">
                                                        <div class="code-embed">
                                                            <svg width="16" height="8" viewBox="0 0 16 8" fill="none">
                                                                <path
                                                                    d="M8.00451 7.76042L1.1459 2.09935C0.422777 1.50248 0.84483 0.328126 1.78247 0.328126L8.69231 0.328126L14.5199 0.328125C15.4199 0.328126 15.8618 1.42415 15.2135 2.04845L9.33471 7.70951C8.96866 8.06201 8.39643 8.08391 8.00451 7.76042Z"
                                                                    fill="#FFA4DB" />
                                                            </svg>
                                                        </div>
                                                    </div>
                                                </div>
                                                <img width="<%= b.w %>" loading="lazy" alt="" src="/images/<%= b.img %>" class="testimonial-img" />
                                            </div>
                                        <% }) %>
                                    </div>
                                    <div class="circle-large" aria-hidden="true">
                                        <% smallBubbles.forEach((b) => { %>
                                            <div class="profile-wrap <%= b.mod %>">
                                                <img width="<%= b.w %>" loading="lazy" alt="" src="/images/<%= b.img %>" class="testimonial-img" />
                                            </div>
                                        <% }) %>
                                    </div>
                                </div>

                                <div class="marquee-wrapper">
                                    <div class="marquee-track">
                                        <div role="list" class="marquee-list" id="marqueeList" aria-label="Mensajes de clientes"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
            </div>

            <div class="cursor" aria-hidden="true">
                <span class="cursor-btn">Comprar</span>
            </div>

            <link rel="stylesheet" href="/css/home.css" />
            <link rel="stylesheet" href="/css/cursor.css" />

            <script src="/js/image-fade.js"></script>
            <script src="/js/testimonials.js"></script>
            <script src="/js/cursor.js"></script>
