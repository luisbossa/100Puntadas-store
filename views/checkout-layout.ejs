<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= locals.pageTitle ? pageTitle + " | 100 Puntadas" : "100 Puntadas" %></title>
    <!-- Páginas de compra: no deben aparecer en buscadores -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#ffa4db" />
    <link rel="icon" href="/favicon.ico" />

    <link rel="stylesheet" href="<%= asset('/css/tokens.css') %>" />
    <link rel="stylesheet" href="<%= asset('/css/fonts.css') %>" />
    <link rel="stylesheet" href="<%= asset('/css/scrollbar.css') %>" />
    <link rel="stylesheet" href="<%= asset('/css/checkout-base.css') %>" />
    <%- style %>
</head>

<body class="<%= locals.bodyClass || '' %>">
    <%- include("partials/checkout-steps", { step: locals.step || 1 }) %>

    <%- body %>

    <%- script %>
</body>

</html>
