<%
  const createdAt = new Date(order.created_at).toLocaleDateString("es-CR", { year: "numeric", month: "long", day: "numeric" });
  const orderNumber = order.order_number || order.id;
  // Detalle de variantes de cada prenda (bikinis: top/bottom/estilo; sets: color; enterizos: talla)
  const variants = (item) => [
    item.size && "Talla: " + item.size,
    item.top_size && "Top: " + item.top_size,
    item.bottom_size && "Bottom: " + item.bottom_size,
    item.bottom_style && item.bottom_style,
    item.color && item.color,
  ].filter(Boolean).join(" · ");

  const wa = store.whatsapp;
  const waProofUrl = `https://wa.me/${wa.number}?text=${encodeURIComponent(`¡Hola 100 Puntadas! Les envío el comprobante de pago del pedido #${orderNumber}.`)}`;

  const bank = [
    { label: "SINPE Móvil", value: "8792-5172", copy: "87925172" },
    { label: "Cuenta IBAN BN", value: "CR02015100320010439147" },
    { label: "Titular", value: "Carmen Medina Puerta" },
  ];
%>
<main class="sinpe-page">
    <!-- ENCABEZADO -->
    <header class="sinpe-hero">
        <span class="sinpe-hero__icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12.5l4.5 4.5L19 7.5" />
            </svg>
        </span>
        <h1 class="sinpe-hero__title">Pedido recibido</h1>
        <p class="sinpe-hero__lead">Solo falta un paso: realiza tu pago y envíanos el comprobante.</p>
    </header>

    <!-- RESUMEN -->
    <section class="sinpe-summary" aria-label="Resumen del pedido">
        <div class="sinpe-stat">
            <span class="sinpe-stat__label">Número de pedido</span>
            <span class="sinpe-stat__value">#<%= orderNumber %></span>
        </div>
        <div class="sinpe-stat">
            <span class="sinpe-stat__label">Fecha</span>
            <span class="sinpe-stat__value"><%= createdAt %></span>
        </div>
        <div class="sinpe-stat sinpe-stat--total">
            <span class="sinpe-stat__label">Total a pagar</span>
            <span class="sinpe-stat__value"><%= formatPrice(order.total) %></span>
        </div>
        <div class="sinpe-stat">
            <span class="sinpe-stat__label">Método de pago</span>
            <span class="sinpe-stat__value"><%= order.payment_method === 'sinpe' ? 'SINPE / Transferencia' : 'Tarjeta' %></span>
        </div>
    </section>

    <div class="sinpe-grid">
        <!-- CÓMO PAGAR -->
        <section class="sinpe-card" aria-labelledby="steps-title">
            <h2 id="steps-title" class="sinpe-card__title">Cómo completar tu pago</h2>
            <ol class="sinpe-steps">
                <li>Paga el total por <strong>SINPE Móvil</strong> o <strong>transferencia</strong> con los datos bancarios.</li>
                <li>Usa tu <strong>número de pedido #<%= orderNumber %></strong> como referencia del pago.</li>
                <li>Envía el comprobante por <strong>WhatsApp al <%= wa.display %></strong>.</li>
            </ol>
            <a class="sinpe-wa-btn" href="<%= waProofUrl %>" target="_blank" rel="noopener">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3z" />
                </svg>
                Enviar comprobante
            </a>
        </section>

        <!-- DATOS BANCARIOS -->
        <section class="sinpe-bank" aria-labelledby="bank-title">
            <h2 id="bank-title" class="sinpe-card__title">Nuestros datos bancarios</h2>
            <dl class="sinpe-bank__list">
                <% bank.forEach((b) => { %>
                    <div class="sinpe-bank__row">
                        <div>
                            <dt><%= b.label %></dt>
                            <dd><%= b.value %></dd>
                        </div>
                        <button type="button" class="sinpe-copy" data-copy="<%= b.copy || b.value %>" aria-label="Copiar <%= b.label %>">Copiar</button>
                    </div>
                <% }) %>
            </dl>
        </section>
    </div>

    <!-- DETALLE -->
    <section class="sinpe-card" aria-labelledby="detail-title">
        <h2 id="detail-title" class="sinpe-card__title">Detalles del pedido</h2>
        <div class="order-table-wrap">
            <table class="order-table">
                <thead>
                    <tr>
                        <th scope="col">Producto</th>
                        <th scope="col">Detalle</th>
                        <th scope="col">Precio</th>
                        <th scope="col">Total</th>
                    </tr>
                </thead>
                <tbody>
                    <% orderItems.forEach((item) => { %>
                        <tr>
                            <td class="order-table__name"><%= item.product_name %></td>
                            <td class="order-table__meta"><%= variants(item) %> × <%= item.quantity %></td>
                            <td class="order-table__price"><%= formatPrice(item.price) %></td>
                            <td class="order-table__price"><%= formatPrice(item.price * item.quantity) %></td>
                        </tr>
                    <% }) %>
                </tbody>
                <tfoot>
                    <tr>
                        <th scope="row" colspan="3">Subtotal</th>
                        <td><%= formatPrice(order.subtotal) %></td>
                    </tr>
                    <% if (Number(order.discount) > 0) { %>
                        <tr class="order-table__discount">
                            <th scope="row" colspan="3">Descuento</th>
                            <td>−<%= formatPrice(order.discount) %></td>
                        </tr>
                    <% } %>
                    <tr>
                        <th scope="row" colspan="3">Envío</th>
                        <td><%= formatPrice(order.shipping) %></td>
                    </tr>
                    <tr class="order-table__total">
                        <th scope="row" colspan="3">Total</th>
                        <td><%= formatPrice(order.total) %></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </section>

    <!-- CONFIRMACIÓN -->
    <section class="sinpe-confirm" aria-label="Confirmación del pago">
        <div class="pending-msg<%= confirmed ? ' is-confirmed' : '' %>" id="sinpeStatus" role="status" aria-live="polite">
            <% if (confirmed) { %>
                ✅ Pago confirmado. Ya puedes ver tu pedido.
            <% } else if (cancelled) { %>
                Este pedido fue cancelado. Si ya realizaste el pago, escríbenos por WhatsApp con tu número de pedido.
            <% } else { %>
                Tu pago SINPE está en proceso de verificación. El botón <strong>“Ver mi pedido”</strong> se habilitará
                automáticamente cuando confirmemos el comprobante.
            <% } %>
        </div>

        <% if (!cancelled) { %>
            <button type="button" id="sinpeConfirmBtn" class="sinpe-confirm-btn" <%= confirmed ? "" : "disabled" %>
                data-order-token="<%= orderToken %>">
                <%= confirmed ? "Ver mi pedido" : "Esperando confirmación…" %>
            </button>
        <% } %>
    </section>
</main>

<link rel="stylesheet" href="<%= asset('/css/sinpe-pay.css') %>" />

<script src="<%= asset('/js/sinpe-pay.js') %>"></script>
