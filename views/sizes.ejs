<%
  const guides = [
    {
      title: "¿Cómo medirte?",
      note: "Para una medición precisa, coloca la cinta alrededor de tu cuerpo sin apretar.",
      tips: [
        "La medida de la cintura únicamente es necesaria para enterizos.",
        "Para bikinis de dos piezas, toma la medida de la cadera en la parte media de los glúteos.",
      ],
      img: "/images/sizeChart/hip-size.webp",
      alt: "Guía de medidas corporales",
    },
    {
      title: "Tipos de copa",
      note: "Utiliza estas referencias como guía para determinar tu talla de top.",
      img: "/images/sizeChart/copa-size.webp",
      alt: "Guía de estilos de copa",
    },
    {
      title: "Tipos de cobertura",
      note: "Elige la cobertura que desees según tu preferencia: hilo o regular.",
      img: "/images/sizeChart/bottom-style.webp",
      alt: "Guía de estilos de parte de abajo",
    },
  ];
  const wa = store.whatsapp;
  const waUrl = `https://wa.me/${wa.number}?text=${encodeURIComponent(wa.message)}`;
%>
            <div class="sizes page-section">
                <!-- Encabezado -->
                <header class="sizes__hero">
                    <span class="sizes__eyebrow">Guía de tallas</span>
                    <h1 class="sizes__title">Tabla de medidas</h1>
                    <p class="sizes__lead">Compara tus medidas con la tabla y elige la talla de tu top y tu bottom por separado.</p>
                </header>

                <%- include("partials/size-table") %>

                <!-- Ayuda por WhatsApp -->
                <div class="sizes__help">
                    <p class="sizes__help-text"><strong>¿Dudas con tu talla?</strong> Escríbenos y te ayudamos a elegir.</p>
                    <a class="sizes__help-btn" href="<%= waUrl %>" target="_blank" rel="noopener">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3z" />
                        </svg>
                        Escríbenos por WhatsApp
                    </a>
                </div>

                <!-- Guías visuales -->
                <div class="sizes__guides">
                    <% guides.forEach((g, i) => { %>
                        <article class="sizes-guide">
                            <span class="sizes-guide__num" aria-hidden="true"><%= String(i + 1).padStart(2, "0") %></span>
                            <h2 class="sizes-guide__title"><%= g.title %></h2>
                            <p class="sizes-guide__note"><%= g.note %></p>
                            <% if (g.tips) { %>
                                <ol class="sizes-guide__tips">
                                    <% g.tips.forEach((tip) => { %>
                                        <li><%= tip %></li>
                                    <% }) %>
                                </ol>
                            <% } %>
                            <figure class="sizes-guide__media">
                                <%- img(g.img, { alt: g.alt, class: "sizes-guide__image", sizes: "(max-width: 600px) 90vw, 30vw" }) %>
                            </figure>
                        </article>
                    <% }) %>
                </div>
            </div>

<link rel="stylesheet" href="<%= asset('/css/size-table.css') %>" />
<link rel="stylesheet" href="<%= asset('/css/sizes.css') %>" />
