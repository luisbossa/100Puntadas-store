<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

<%
  const siteUrl = "https://100puntadas.vercel.app";
  const title = locals.pageTitle ? pageTitle + " | 100 Puntadas" : "100 Puntadas | Vestidos de baño de crochet";
  const description = locals.pageDescription ||
    "100 Puntadas es una tienda virtual de vestidos de baño tejidos a mano en crochet. Diseños únicos, artesanales y hechos en Costa Rica.";
  const image = absUrl(locals.pageImage || "/images/og-image.png");
%>
    <title><%= title %></title>
    <meta name="description" content="<%= description %>" />
    <meta name="keywords"
        content="vestidos de baño crochet, bikinis crochet, trajes de baño artesanales, tienda online Costa Rica, ropa de playa hecha a mano" />
    <meta name="author" content="100 Puntadas" />
    <meta name="theme-color" content="#ffa4db" />

    <link rel="icon" href="/favicon.ico" />

    <link rel="canonical" href="<%= siteUrl + (locals.canonicalPath || '/') %>" />

    <meta property="og:title" content="<%= title %>" />
    <meta property="og:description" content="<%= description %>" />
    <meta property="og:image" content="<%= image %>" />
    <meta property="og:url" content="<%= siteUrl + (locals.canonicalPath || '/') %>" />
    <meta property="og:type" content="<%= locals.ogType || 'website' %>" />
    <meta property="og:locale" content="es_CR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="<%= title %>" />
    <meta name="twitter:description" content="<%= description %>" />
    <meta name="twitter:image" content="<%= image %>" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-7E1GDJ19CS"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());

        gtag('config', 'G-7E1GDJ19CS');
    </script>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
      "@type": "Store",
      "name": "100 Puntadas",
      "image": "https://100puntadas.vercel.app/images/og-image.png",
      "url": "https://100puntadas.vercel.app",
      "description": "Tienda online de vestidos de baño tejidos a mano en crochet. Diseños únicos hechos en Costa Rica.",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "San Ramón",
        "addressRegion": "Alajuela",
        "addressCountry": "Costa Rica"
      }
    }
    </script>

    <%- defineContent("head") %>

    <link rel="preload" href="/fonts/Hatton-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="<%= asset('/css/tokens.css') %>" />
    <link rel="stylesheet" href="<%= asset('/css/fonts.css') %>" />
    <link rel="stylesheet" href="<%= asset('/css/scrollbar.css') %>" />
    <link rel="stylesheet" href="<%= asset('/css/reset.css') %>" />
    <link rel="stylesheet" href="<%= asset('/css/base.css') %>" />
    <link rel="stylesheet" href="<%= asset('/css/header.css') %>" />
    <link rel="stylesheet" href="<%= asset('/css/footer.css') %>" />
    <link rel="stylesheet" href="<%= asset('/css/cart.css') %>" />
    <%- style %>

    <script>
        document.documentElement.classList.add("js");
    </script>
</head>

<body>
    <a class="skip-link" href="#main">Saltar al contenido</a>

    <%- include("partials/header", { isHome: locals.isHome === true, noCursorZone: locals.noCursorZone === true }) %>

    <%- defineContent("modals") %>

    <div class="page-wrapper">
        <main id="main">
            <%- body %>
        </main>

        <div class="footer-anim-wrapper no-cursor-zone">
            <%- include("partials/footer", { variant: "placeholder" }) %>
        </div>
    </div>

    <div class="footer-wrapper no-cursor-zone">
        <%- include("partials/footer", { variant: "fixed" }) %>
    </div>

    <div id="cartOverlay" class="cart-overlay"></div>

    <aside id="cartPanel" class="cart-panel" role="dialog" aria-modal="true" aria-labelledby="cartTitle"
        aria-hidden="true">
        <header class="cart-panel__header">
            <h2 id="cartTitle" class="cart-panel__title">
                Tu carrito <span class="cart-panel__count" id="cartTitleCount"></span>
            </h2>
            <button type="button" id="closeCartBtn" class="cart-panel__close" aria-label="Cerrar carrito">
                <span></span>
                <span></span>
            </button>
        </header>

        <!-- Promo "lleva dos y ahorra" con barra de progreso -->
        <div class="cart-promo" id="cartPromo" hidden>
            <p class="cart-promo__text" id="cartPromoText"></p>
            <div class="cart-promo__track" aria-hidden="true">
                <span class="cart-promo__fill" id="cartPromoFill"></span>
            </div>
        </div>

        <!-- Carrito vacío -->
        <div class="cart-empty" id="emptyCartMessage">
            <svg class="cart-empty__art" viewBox="0 0 160 160" width="150" height="150" aria-hidden="true">
                <circle class="art-bg" cx="80" cy="82" r="66" />
                <!-- top -->
                <path class="art-line" d="M38 78h84 M68 44 64 26 M92 44 96 26" />
                <path class="art-piece" d="M46 78 68 44 74 78Z M86 78 92 44 114 78Z" />
                <path class="art-stitch" d="M52 74 68 50 M108 74 92 50" />
                <!-- bottom -->
                <path class="art-line" d="M44 98h72" />
                <path class="art-piece" d="M52 98h56l-14 26q-14 8-28 0Z" />
                <path class="art-stitch" d="M58 103h44" />
                <!-- destellos -->
                <path class="art-sparkle" d="M128 36l3 8 8 3-8 3-3 8-3-8-8-3 8-3Z M30 120l2 5 5 2-5 2-2 5-2-5-5-2 5-2Z" />
            </svg>
            <h3 class="cart-empty__title">Tu carrito está vacío</h3>
            <p class="cart-empty__text">Descubre nuestras piezas tejidas a mano, hechas para el verano.</p>
            <div class="cart-empty__actions">
                <a href="/#bikinis" class="cart-btn cart-btn--solid" data-close-cart>Ver bikinis</a>
                <a href="/#sets" class="cart-btn cart-btn--outline" data-close-cart>Sets de playa</a>
            </div>
            <p class="cart-empty__hint">✦ <%= locals.campaign && campaign.suspend_bundle_promo
                ? `${campaign.name}: ${campaign.percent}% de descuento`
                : "Lleva dos prendas y ahorra 15%" %> ✦</p>
        </div>

        <ul class="cart-items" role="list" aria-live="polite"></ul>

        <footer class="cart-panel__footer" id="cartFooter">
            <dl class="cart-summary">
                <div class="cart-summary__row">
                    <dt>Subtotal</dt>
                    <dd id="cartSubtotal">0 ₡</dd>
                </div>
                <div class="cart-summary__row cart-summary__row--discount" id="discountRow" hidden>
                    <dt>Descuento (15%)</dt>
                    <dd>-<span id="cartDiscount">0 ₡</span></dd>
                </div>
                <div class="cart-summary__row cart-summary__row--muted">
                    <dt>Envío</dt>
                    <dd>Se calcula en el checkout</dd>
                </div>
                <div class="cart-summary__row cart-summary__row--total">
                    <dt>Total</dt>
                    <dd id="cartTotal">0 ₡</dd>
                </div>
            </dl>

            <a href="/checkout" class="cart-btn cart-btn--solid cart-btn--block" id="checkoutBtn">Finalizar compra</a>
            <button type="button" class="cart-panel__continue" data-close-cart>Seguir comprando</button>
        </footer>
    </aside>


    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
    <script>
        window.COLOR_LABELS = <%- JSON.stringify(colorLabels) %>;
    </script>
    <script src="<%= asset('/js/constants.js') %>"></script>
    <script src="<%= asset('/js/pricing.js') %>"></script>
    <script src="<%= asset('/js/header.js') %>"></script>
    <script src="<%= asset('/js/cart.js') %>"></script>
    <script src="<%= asset('/js/footer.js') %>"></script>

    <%- script %>
</body>

</html>