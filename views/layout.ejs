<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

<%
  const siteUrl = "https://100puntadas.vercel.app";
  const title = locals.pageTitle ? pageTitle + " | 100 Puntadas" : "100 Puntadas | Vestidos de baño de crochet";
  const description = locals.pageDescription ||
    "100 Puntadas es una tienda virtual de vestidos de baño tejidos a mano en crochet. Diseños únicos, artesanales y hechos en Costa Rica.";
  const image = siteUrl + (locals.pageImage || "/images/og-image.png");
%>
    <title><%= title %></title>
    <meta name="description" content="<%= description %>" />
    <meta name="keywords"
        content="vestidos de baño crochet, bikinis crochet, trajes de baño artesanales, tienda online Costa Rica, ropa de playa hecha a mano" />
    <meta name="author" content="100 Puntadas" />
    <meta name="theme-color" content="#ffa4db" />

    <link rel="icon" href="/favicon.ico" />

    <link rel="canonical" href="<%= siteUrl + (locals.canonicalPath || '/') %>" />

    <meta property="og:title" content="<%= title %>" />
    <meta property="og:description" content="<%= description %>" />
    <meta property="og:image" content="<%= image %>" />
    <meta property="og:url" content="<%= siteUrl + (locals.canonicalPath || '/') %>" />
    <meta property="og:type" content="<%= locals.ogType || 'website' %>" />
    <meta property="og:locale" content="es_CR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="<%= title %>" />
    <meta name="twitter:description" content="<%= description %>" />
    <meta name="twitter:image" content="<%= image %>" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-7E1GDJ19CS"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());

        gtag('config', 'G-7E1GDJ19CS');
    </script>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
      "@type": "Store",
      "name": "100 Puntadas",
      "image": "https://100puntadas.vercel.app/images/og-image.png",
      "url": "https://100puntadas.vercel.app",
      "description": "Tienda online de vestidos de baño tejidos a mano en crochet. Diseños únicos hechos en Costa Rica.",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "San Ramón",
        "addressRegion": "Alajuela",
        "addressCountry": "Costa Rica"
      }
    }
    </script>

    <%- defineContent("head") %>

    <link rel="preload" href="/fonts/Hatton-Medium.otf" as="font" type="font/otf" crossorigin />
    <link rel="stylesheet" href="/css/tokens.css" />
    <link rel="stylesheet" href="/css/reset.css" />
    <link rel="stylesheet" href="/css/base.css" />
    <link rel="stylesheet" href="/css/header.css" />
    <link rel="stylesheet" href="/css/footer.css" />
    <link rel="stylesheet" href="/css/cart.css" />
    <%- style %>

    <script>
        document.documentElement.classList.add("js");
    </script>
</head>

<body>
    <a class="skip-link" href="#main">Saltar al contenido</a>

    <%- include("partials/header", { isHome: locals.isHome === true, noCursorZone: locals.noCursorZone === true }) %>

    <%- defineContent("modals") %>

    <div class="page-wrapper">
        <main id="main">
            <%- body %>
        </main>

        <div class="footer-anim-wrapper no-cursor-zone">
            <%- include("partials/footer", { variant: "placeholder" }) %>
        </div>
    </div>

    <div class="footer-wrapper no-cursor-zone">
        <%- include("partials/footer", { variant: "fixed" }) %>
    </div>

    <div id="cartOverlay" class="cart-overlay"></div>

    <aside id="cartPanel" class="cart-panel" role="dialog" aria-modal="true" aria-labelledby="cartTitle"
        aria-hidden="true">
        <div class="cart-header">
            <h2 id="cartTitle">Tu carrito</h2>
            <button type="button" id="closeCartBtn" class="cart-close-btn" aria-label="Cerrar carrito">✕</button>
        </div>

        <div id="emptyCartMessage" class="emptyCartMessage">
            <img class="cart-img" src="/images/cart-img.png" alt="" loading="lazy">
            Aún no has agregado ningún vestido de baño a tu carrito.
        </div>

        <div class="cart-items" aria-live="polite"></div>

        <div class="cart-footer">
            <p class="cart-promo" id="cartPromo" hidden></p>

            <div class="totals">
                <div class="totals-row" id="discountRow" style="display:none;">
                    <span>Descuento (15%)</span>
                    <span class="red-discount">-<span id="cartDiscount">0 ₡</span></span>
                </div>

                <div class="totals-row total-row" id="totalRow">
                    <strong>Total</strong>
                    <strong id="cartTotal">0 ₡</strong>
                </div>
            </div>

            <a href="/checkout" class="cart-checkout-btn" id="checkoutBtn">
                Finalizar compra
            </a>
        </div>
    </aside>


    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
    <script src="/js/constants.js"></script>
    <script src="/js/pricing.js"></script>
    <script src="/js/res-menu.js"></script>
    <script src="/js/cart.js"></script>
    <script src="/js/footer.js"></script>

    <%- script %>
</body>

</html>